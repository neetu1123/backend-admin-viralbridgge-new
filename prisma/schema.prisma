generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String           @id @default(uuid())
  firebase_uid     String?          @unique
  password         String?
  name             String
  email            String           @unique
  avatar           String?
  role_id          String?
  role             Role?            @relation(fields: [role_id], references: [id])
  status           String           @default("ACTIVE")
  is_verified      Boolean          @default(false)
  is_banned        Boolean          @default(false)
  is_deleted       Boolean          @default(false)
  created_at       DateTime         @default(now())
  updated_at       DateTime         @updatedAt

  creator_profile  CreatorProfile?
  brand_profile    BrandProfile?
  wallets          Wallet[]
  notifications    Notification[]
  audit_logs       AuditLog[]
  messages         Message[]
  settings         Json?
  kyc_requests     KycRequest[]
  creator_kyc      CreatorKyc?
  brand_kyc        BrandKyc?
  owned_organizations Organization[] @relation("OrganizationOwner")
  organization_members OrganizationMember[]
  organization_invitations_sent OrganizationInvitation[] @relation("InvitationInviter")
  security_setting     SecuritySetting?
  user_sessions        UserSession[]
  security_activities  SecurityActivity[]
  notification_prefs   NotificationPreference?
  user_activity        UserActivity?
  campaign_prompt_events CampaignPromptEvent[]
  re_engagement_emails ReEngagementEmailLog[]
  crm_leads_assigned    CrmLead[] @relation("CrmLeadAssignee")
  crm_leads_created     CrmLead[] @relation("CrmLeadCreator")
  crm_agent_profile     CrmAgent?
  crm_assignments_made  CrmLeadAssignment[] @relation("CrmAssignmentBy")
  crm_import_jobs       CrmImportJob[]
  crm_export_jobs       CrmExportJob[]
  support_cases         SupportCase[] @relation("SupportCaseUser")
  support_cases_assigned SupportCase[] @relation("SupportCaseAssignee")
  support_messages      SupportCaseMessage[]
  support_notes         SupportCaseNote[]

  @@map("users")
}

model Role {
  id               String           @id @default(uuid())
  name             String           @unique
  description      String?
  users            User[]
  permissions      RolePermission[]

  @@map("roles")
}

model Permission {
  id               String           @id @default(uuid())
  key              String           @unique
  description      String?
  roles            RolePermission[]

  @@map("permissions")
}

model RolePermission {
  role_id          String
  permission_id    String
  role             Role       @relation(fields: [role_id], references: [id])
  permission       Permission @relation(fields: [permission_id], references: [id])

  @@id([role_id, permission_id])
  @@map("role_permissions")
}

model CreatorProfile {
  id               String       @id @default(uuid())
  user_id          String       @unique
  user             User         @relation(fields: [user_id], references: [id])
  full_name        String?
  bio              String?
  niche            String?
  followers        Int          @default(0)
  engagement_rate  Float        @default(0.0)
  languages        String[]
  locality         String?
  social_links     Json?
  media_kit        String?
  portfolio        String?
  contact_email    String?
  phone            String?
  photo            String?
  created_at       DateTime     @default(now())
  updated_at       DateTime     @updatedAt

  applications     Application[]
  conversations    Conversation[]
  disputes         Dispute[]
  escrows          Escrow[]
  deliverables     Deliverable[]
  withdrawals      Withdrawal[]
  ai_matches       AiMatch[]
  organization     Organization?

  @@map("creator_profiles")
}

model BrandProfile {
  id               String       @id @default(uuid())
  user_id          String       @unique
  user             User         @relation(fields: [user_id], references: [id])
  company_name     String
  industry         String?
  website          String?
  description      String?
  logo             String?
  contact_email    String?
  phone            String?
  location         String?
  created_at       DateTime     @default(now())
  updated_at       DateTime     @updatedAt

  campaigns        Campaign[]
  conversations    Conversation[]
  disputes         Dispute[]
  escrows          Escrow[]
  organization     Organization?

  @@map("brand_profiles")
}

model Campaign {
  id                   String       @id @default(uuid())
  brand_id             String
  brand                BrandProfile @relation(fields: [brand_id], references: [id])
  title                String
  description          String
  platform             String
  budget               Float
  remaining_budget     Float
  deadline             DateTime
  deliverables         String[]
  status               String       @default("DRAFT") // ACTIVE, DRAFT, PENDING_APPROVAL, FLAGGED, COMPLETED, FROZEN
  locality             String?
  languages            String[]
  created_by_admin_id  String?
  metadata             Json?
  created_at           DateTime     @default(now())
  updated_at           DateTime     @updatedAt

  applications     Application[]
  escrows          Escrow[]
  disputes         Dispute[]
  campaignDeliverables Deliverable[]
  ai_matches       AiMatch[]

  @@map("campaigns")
}

model Application {
  id               String       @id @default(uuid())
  creator_id       String
  creator          CreatorProfile @relation(fields: [creator_id], references: [id])
  campaign_id      String
  campaign         Campaign       @relation(fields: [campaign_id], references: [id])
  message          String?
  proposed_price   Float?
  rejection_reason String?
  status           String         @default("PENDING") // PENDING, SHORTLISTED, ACCEPTED, REJECTED, COMPLETED
  created_at       DateTime       @default(now())
  updated_at       DateTime       @updatedAt
  deliverables     Deliverable[]

  @@map("applications")
}

model Deliverable {
  id               String         @id @default(uuid())
  campaign_id      String
  campaign         Campaign       @relation(fields: [campaign_id], references: [id])
  application_id   String?
  application      Application?   @relation(fields: [application_id], references: [id])
  creator_id       String
  creator          CreatorProfile @relation(fields: [creator_id], references: [id])
  title            String
  type             String?
  media_url        String?
  file_url         String?
  thumbnail_url    String?
  notes            String?
  revision_notes   String?
  version          Int            @default(1)
  status           String         @default("PENDING") // PENDING, SUBMITTED, REVISION_REQUESTED, APPROVED, REJECTED
  due_date         DateTime?
  submitted_at     DateTime?
  reviewed_at      DateTime?
  auto_release_at  DateTime?
  created_at       DateTime       @default(now())
  updated_at       DateTime       @updatedAt

  @@index([campaign_id, status])
  @@index([status, auto_release_at])
  @@map("deliverables")
}

model Wallet {
  id                String       @id @default(uuid())
  user_id           String       @unique
  user              User         @relation(fields: [user_id], references: [id])
  available_balance Float        @default(0.0)
  locked_balance    Float        @default(0.0)
  pending_balance   Float        @default(0.0)
  lifetime_earnings Float        @default(0.0)
  currency          String       @default("INR")
  is_platform       Boolean      @default(false)
  is_frozen         Boolean      @default(false)
  created_at        DateTime     @default(now())
  updated_at        DateTime     @updatedAt

  transactions      WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id             String   @id @default(uuid())
  wallet_id      String
  wallet         Wallet   @relation(fields: [wallet_id], references: [id])
  type           String
  amount         Float
  balance_after  Float?
  reference_type String?
  reference_id   String?
  status         String   @default("COMPLETED")
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@index([wallet_id, created_at])
  @@index([reference_type, reference_id])
  @@map("wallet_transactions")
}

model Escrow {
  id                   String         @id @default(uuid())
  campaign_id          String
  campaign             Campaign       @relation(fields: [campaign_id], references: [id])
  brand_id             String
  brand                BrandProfile   @relation(fields: [brand_id], references: [id])
  creator_id           String
  creator              CreatorProfile @relation(fields: [creator_id], references: [id])
  amount               Float
  platform_fee_percent Float          @default(10.0)
  platform_fee_amount  Float          @default(0.0)
  creator_amount       Float          @default(0.0)
  platform_fee         Float          @default(0.0)
  payment_gateway      String?
  payment_id           String?
  status               String         @default("PENDING")
  locked_at            DateTime?
  funded_at            DateTime?
  created_at           DateTime       @default(now())
  released_at          DateTime?
  refunded_at          DateTime?
  updated_at           DateTime       @updatedAt

  payment_orders       PaymentOrder[]

  @@index([campaign_id, creator_id, brand_id])
  @@index([status])
  @@map("escrows")
}

model Withdrawal {
  id               String         @id @default(uuid())
  creator_id       String
  creator          CreatorProfile @relation(fields: [creator_id], references: [id])
  amount           Float
  status           String         @default("PENDING") // PENDING, APPROVED, REJECTED
  transaction_id   String?        @unique
  requested_at     DateTime       @default(now())
  approved_at      DateTime?
  rejected_at      DateTime?
  rejection_reason String?
  created_at       DateTime       @default(now())
  updated_at       DateTime       @updatedAt

  @@index([creator_id, status])
  @@map("withdrawals")
}

model NotificationPreference {
  id               String   @id @default(uuid())
  user_id          String   @unique
  user             User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  email_enabled    Boolean  @default(true)
  push_enabled     Boolean  @default(true)
  payment_alerts   Boolean  @default(true)
  campaign_alerts  Boolean  @default(true)
  marketing_emails Boolean  @default(false)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@map("notification_preferences")
}

model Conversation {
  id               String         @id @default(uuid())
  creator_id       String
  creator          CreatorProfile @relation(fields: [creator_id], references: [id])
  brand_id         String
  brand            BrandProfile   @relation(fields: [brand_id], references: [id])
  created_at       DateTime       @default(now())
  updated_at       DateTime       @updatedAt

  messages         Message[]

  @@map("conversations")
}

model Message {
  id               String         @id @default(uuid())
  conversation_id  String
  conversation     Conversation   @relation(fields: [conversation_id], references: [id])
  sender_id        String
  sender           User           @relation(fields: [sender_id], references: [id])
  message          String
  type             String         @default("text")
  file_url         String?
  file_name        String?
  file_size        String?
  created_at       DateTime       @default(now())
  read_at          DateTime?

  @@map("messages")
}

model Notification {
  id               String         @id @default(uuid())
  user_id          String
  user             User           @relation(fields: [user_id], references: [id])
  title            String
  body             String
  type             String         @default("SYSTEM")
  entity_type      String?
  entity_id        String?
  metadata         Json?
  is_read          Boolean        @default(false)
  created_at       DateTime       @default(now())

  @@index([user_id, is_read])
  @@index([user_id, created_at])
  @@map("notifications")
}

model Dispute {
  id               String         @id @default(uuid())
  campaign_id      String
  campaign         Campaign       @relation(fields: [campaign_id], references: [id])
  creator_id       String
  creator          CreatorProfile @relation(fields: [creator_id], references: [id])
  brand_id         String
  brand            BrandProfile   @relation(fields: [brand_id], references: [id])
  reason           String
  raised_by        String         @default("brand") // brand, creator
  status           String         @default("OPEN") // OPEN, IN_REVIEW, RESOLVED, REFUNDED
  resolution_notes String?
  created_at       DateTime       @default(now())
  updated_at       DateTime       @updatedAt

  @@index([campaign_id, creator_id, status])
  @@map("disputes")
}

model PaymentOrder {
  id                  String   @id @default(uuid())
  user_id             String
  escrow_id           String?
  escrow              Escrow?  @relation(fields: [escrow_id], references: [id])
  purpose             String   @default("WALLET_TOPUP")
  razorpay_order_id   String   @unique
  razorpay_payment_id String?
  amount              Float
  currency            String   @default("INR")
  status              String   @default("CREATED")
  metadata            Json?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  @@index([user_id, status])
  @@index([escrow_id])
  @@map("payment_orders")
}

model AuditLog {
  id               String         @id @default(uuid())
  admin_id         String
  admin            User           @relation(fields: [admin_id], references: [id])
  action           String
  entity           String
  entity_id        String
  metadata         Json?
  created_at       DateTime       @default(now())

  @@map("audit_logs")
}

model PlatformSettings {
  id                              String   @id @default("default")
  ai_matching_enabled             Boolean  @default(true)
  platform_fee_percent            Float    @default(10)
  reengagement_enabled            Boolean  @default(false)
  reengagement_inactive_period    String   @default("7d")
  reengagement_email_frequency_days Int    @default(7)
  updated_at                      DateTime @updatedAt
  updated_by                      String?

  @@map("platform_settings")
}

model UserActivity {
  id                     String    @id @default(uuid())
  user_id                String    @unique
  user                   User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  last_login             DateTime?
  last_active            DateTime?
  last_campaign_activity DateTime?
  last_wallet_activity   DateTime?
  last_message_activity  DateTime?
  updated_at             DateTime  @updatedAt

  @@index([last_active])
  @@map("user_activity")
}

model CampaignPromptEvent {
  id         String   @id @default(uuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  event_type String
  metadata   Json?
  created_at DateTime @default(now())

  @@index([user_id, event_type])
  @@index([user_id, created_at])
  @@map("campaign_prompt_events")
}

model ReEngagementEmailLog {
  id          String    @id @default(uuid())
  user_id     String
  user        User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_type   String
  email       String
  subject     String
  resend_id   String?
  sent_at     DateTime  @default(now())
  opened_at   DateTime?
  returned_at DateTime?

  @@index([user_id, sent_at])
  @@index([sent_at])
  @@map("re_engagement_email_logs")
}

model AiMatch {
  id           String         @id @default(uuid())
  campaign_id  String
  creator_id   String
  match_score  Int
  reasons      String[]
  status       String         @default("active") // active, removed, forced
  matched_at   DateTime       @default(now())
  campaign     Campaign       @relation(fields: [campaign_id], references: [id], onDelete: Cascade)
  creator      CreatorProfile @relation(fields: [creator_id], references: [id], onDelete: Cascade)

  @@unique([campaign_id, creator_id])
  @@map("ai_matches")
}

model RevokedToken {
  id         String   @id @default(uuid())
  jti        String   @unique
  user_id    String
  expires_at DateTime
  created_at DateTime @default(now())

  @@index([user_id])
  @@map("revoked_tokens")
}

model KycRequest {
  id           String      @id @default(uuid())
  user_id      String
  user         User        @relation(fields: [user_id], references: [id])
  user_type    String
  status       String      @default("PENDING")
  submitted_at DateTime    @default(now())
  reviewed_at  DateTime?
  reviewed_by  String?
  remarks      String?
  creator_kyc  CreatorKyc?
  brand_kyc    BrandKyc?

  @@index([user_id])
  @@index([status])
  @@map("kyc_requests")
}

model CreatorKyc {
  id                    String      @id @default(uuid())
  user_id               String      @unique
  user                  User        @relation(fields: [user_id], references: [id])
  kyc_request_id        String?     @unique
  kyc_request           KycRequest? @relation(fields: [kyc_request_id], references: [id])
  mobile_number         String?
  mobile_verified       Boolean     @default(false)
  email_verified        Boolean     @default(false)
  instagram_handle      String?
  youtube_handle        String?
  tiktok_handle         String?
  instagram_profile_url String?
  selfie_url            String?
  followers_count       Int         @default(0)
  engagement_rate       Float       @default(0)
  verification_status   String      @default("UNVERIFIED")
  created_at            DateTime    @default(now())
  updated_at            DateTime    @updatedAt

  @@map("creator_kyc")
}

model BrandKyc {
  id                      String      @id @default(uuid())
  user_id                   String      @unique
  user                      User        @relation(fields: [user_id], references: [id])
  kyc_request_id            String?     @unique
  kyc_request               KycRequest? @relation(fields: [kyc_request_id], references: [id])
  company_name              String?
  gst_number                String?
  website                   String?
  business_email            String?
  business_email_verified   Boolean     @default(false)
  linkedin_url              String?
  logo_url                  String?
  business_address          String?
  verification_status       String      @default("UNVERIFIED")
  created_at                DateTime    @default(now())
  updated_at                DateTime    @updatedAt

  @@map("brand_kyc")
}

model Organization {
  id                String   @id @default(uuid())
  type              String   // BRAND | CREATOR
  name              String
  owner_user_id     String
  owner             User     @relation("OrganizationOwner", fields: [owner_user_id], references: [id])
  brand_profile_id  String?  @unique
  brand_profile     BrandProfile? @relation(fields: [brand_profile_id], references: [id])
  creator_profile_id String? @unique
  creator_profile   CreatorProfile? @relation(fields: [creator_profile_id], references: [id])
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  members           OrganizationMember[]
  invitations       OrganizationInvitation[]

  @@index([type, owner_user_id])
  @@map("organizations")
}

model OrganizationMember {
  id              String   @id @default(uuid())
  organization_id String
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  user_id         String
  user            User     @relation(fields: [user_id], references: [id])
  role            String   // OWNER, CAMPAIGN_MANAGER, FINANCE_MANAGER, VIEWER, MANAGER, EDITOR
  status          String   @default("ACTIVE") // ACTIVE, REMOVED
  invited_by_id   String?
  last_active_at  DateTime?
  joined_at       DateTime @default(now())
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@unique([organization_id, user_id])
  @@index([user_id, status])
  @@map("organization_members")
}

model OrganizationInvitation {
  id              String   @id @default(uuid())
  organization_id String
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  email           String
  role            String
  token           String   @unique @default(uuid())
  invited_by_id   String
  invited_by      User     @relation("InvitationInviter", fields: [invited_by_id], references: [id])
  status          String   @default("PENDING") // PENDING, ACCEPTED, REVOKED, EXPIRED (legacy: CANCELLED)
  expires_at      DateTime
  accepted_at     DateTime?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@index([email, status])
  @@index([token])
  @@map("organization_invitations")
}

model SecuritySetting {
  id                   String    @id @default(uuid())
  user_id              String    @unique
  user                 User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  two_factor_enabled   Boolean   @default(false)
  two_factor_type      String?   // SMS
  phone_number         String?
  mfa_enrollment_id    String?
  last_password_change DateTime?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  @@map("security_settings")
}

model UserSession {
  id            String   @id @default(uuid())
  user_id       String
  user          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  session_token String?  @unique
  device_name   String?
  browser       String?
  ip_address    String?
  location      String?
  is_active     Boolean  @default(true)
  last_active   DateTime @default(now())
  created_at    DateTime @default(now())

  @@index([user_id, is_active])
  @@map("user_sessions")
}

model SecurityActivity {
  id         String   @id @default(uuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  type       String   // NEW_LOGIN, PASSWORD_CHANGED, 2FA_ENABLED, 2FA_DISABLED, SESSION_REMOVED, LOGOUT_ALL
  device     String?
  browser    String?
  ip_address String?
  location   String?
  metadata   Json?
  created_at DateTime @default(now())

  @@index([user_id, created_at])
  @@map("security_activities")
}

model CrmLead {
  id                  String   @id @default(uuid())
  first_name          String
  last_name           String
  profile_photo       String?
  gender              String?
  date_of_birth       String?
  email               String
  phone               String
  alternate_phone     String?
  whatsapp            String?
  website             String?
  company             String
  job_title           String?
  industry            String?
  company_size        String?
  gst_number          String?
  country             String?
  state               String?
  city                String?
  postal_code         String?
  address             String?
  lead_type           String
  lead_source         String
  priority            String
  lead_status         String   @default("New")
  assigned_to_id      String?
  assigned_to         User?    @relation("CrmLeadAssignee", fields: [assigned_to_id], references: [id])
  created_by_id       String?
  created_by          User?    @relation("CrmLeadCreator", fields: [created_by_id], references: [id])
  deal_currency       String   @default("INR")
  deal_value          Float?
  next_follow_up_date String?
  next_follow_up_time String?
  description         String?
  internal_notes      String?
  tags                String[]
  is_deleted          Boolean  @default(false)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  notes               CrmNote[]
  follow_ups          CrmFollowUp[]
  timeline_events     CrmTimelineEvent[]
  attachments         CrmAttachment[]
  assignments         CrmLeadAssignment[]

  @@index([lead_status])
  @@index([assigned_to_id])
  @@index([created_at])
  @@map("crm_leads")
}

model CrmNote {
  id         String   @id @default(uuid())
  lead_id    String
  lead       CrmLead  @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  content    String
  created_by String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("crm_notes")
}

model CrmFollowUp {
  id         String   @id @default(uuid())
  lead_id    String
  lead       CrmLead  @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  title      String
  date       String
  time       String
  status     String   @default("upcoming")
  notes      String?
  created_at DateTime @default(now())

  @@map("crm_follow_ups")
}

model CrmTimelineEvent {
  id          String   @id @default(uuid())
  lead_id     String
  lead        CrmLead  @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  type        String
  title       String
  description String?
  created_by  String?
  created_at  DateTime @default(now())

  @@map("crm_timeline_events")
}

model CrmAttachment {
  id          String   @id @default(uuid())
  lead_id     String
  lead        CrmLead  @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  name        String
  type        String
  size        String?
  uploaded_at DateTime @default(now())

  @@map("crm_attachments")
}

model CrmAgent {
  id            String   @id @default(uuid())
  user_id       String   @unique
  user          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  phone         String?
  status        String   @default("ACTIVE")
  last_activity DateTime?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@map("crm_agents")
}

model CrmLeadAssignment {
  id                String   @id @default(uuid())
  lead_id           String
  lead              CrmLead  @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  previous_agent_id String?
  new_agent_id      String?
  assigned_by_id    String?
  assigned_by       User?    @relation("CrmAssignmentBy", fields: [assigned_by_id], references: [id])
  reason            String?
  assignment_type   String
  created_at        DateTime @default(now())

  @@index([lead_id])
  @@map("crm_lead_assignments")
}

model CrmImportJob {
  id              String   @id @default(uuid())
  file_name       String
  uploaded_by_id  String
  uploaded_by     User     @relation(fields: [uploaded_by_id], references: [id])
  status          String   @default("UPLOADED")
  total_rows      Int      @default(0)
  successful_rows Int      @default(0)
  duplicate_rows  Int      @default(0)
  failed_rows     Int      @default(0)
  warning_rows    Int      @default(0)
  duplicate_strategy String @default("SKIP")
  preview_json    Json?
  file_url        String?
  error_file_url  String?
  started_at      DateTime?
  completed_at    DateTime?
  created_at      DateTime @default(now())

  errors          CrmImportError[]

  @@index([uploaded_by_id])
  @@map("crm_import_jobs")
}

model CrmImportError {
  id             String       @id @default(uuid())
  import_job_id  String
  import_job     CrmImportJob @relation(fields: [import_job_id], references: [id], onDelete: Cascade)
  row_number     Int
  row_data       Json?
  error          String
  suggested_fix  String?

  @@map("crm_import_errors")
}

model CrmExportJob {
  id              String   @id @default(uuid())
  file_name       String
  requested_by_id String
  requested_by    User     @relation(fields: [requested_by_id], references: [id])
  filters_json    Json?
  selected_fields Json?
  record_count    Int      @default(0)
  status          String   @default("PENDING")
  file_content    String?
  created_at      DateTime @default(now())
  completed_at    DateTime?

  @@index([requested_by_id])
  @@map("crm_export_jobs")
}

model SupportCategory {
  id            String   @id @default(uuid())
  role          String
  name          String
  slug          String
  description   String?
  icon          String?
  sort_order    Int      @default(0)
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  subcategories SupportSubcategory[]

  @@unique([role, slug])
  @@map("support_categories")
}

model SupportSubcategory {
  id          String   @id @default(uuid())
  category_id String
  category    SupportCategory @relation(fields: [category_id], references: [id], onDelete: Cascade)
  name        String
  slug        String
  description String?
  sort_order  Int      @default(0)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  issues SupportIssue[]

  @@unique([category_id, slug])
  @@map("support_subcategories")
}

model SupportIssue {
  id              String   @id @default(uuid())
  subcategory_id  String
  subcategory     SupportSubcategory @relation(fields: [subcategory_id], references: [id], onDelete: Cascade)
  title           String
  slug            String
  description     String?
  keywords        String[]
  solution        String?
  action_type     String?
  action_url      String?
  requires_admin  Boolean  @default(false)
  priority        String   @default("MEDIUM")
  case_type       String   @default("GENERAL_SUPPORT")
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@unique([subcategory_id, slug])
  @@map("support_issues")
}

model SupportCase {
  id                String   @id @default(uuid())
  case_number       String   @unique
  user_id           String
  user              User     @relation("SupportCaseUser", fields: [user_id], references: [id])
  user_role         String
  category_id       String?
  subcategory_id    String?
  issue_id          String?
  case_type         String   @default("GENERAL_SUPPORT")
  priority          String   @default("MEDIUM")
  status            String   @default("OPEN")
  subject           String
  description       String
  campaign_id       String?
  payment_id        String?
  transaction_id    String?
  context_json      Json?
  assigned_admin_id String?
  assigned_admin    User?    @relation("SupportCaseAssignee", fields: [assigned_admin_id], references: [id])
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
  resolved_at       DateTime?

  messages    SupportCaseMessage[]
  attachments SupportCaseAttachment[]
  notes       SupportCaseNote[]
  events      SupportCaseEvent[]

  @@index([user_id])
  @@index([status])
  @@index([assigned_admin_id])
  @@map("support_cases")
}

model SupportCaseMessage {
  id          String   @id @default(uuid())
  case_id     String
  case        SupportCase @relation(fields: [case_id], references: [id], onDelete: Cascade)
  sender_id   String
  sender      User     @relation(fields: [sender_id], references: [id])
  sender_role String
  message     String
  created_at  DateTime @default(now())
  read_at     DateTime?

  @@index([case_id])
  @@map("support_case_messages")
}

model SupportCaseAttachment {
  id          String   @id @default(uuid())
  case_id     String
  case        SupportCase @relation(fields: [case_id], references: [id], onDelete: Cascade)
  uploaded_by String
  file_name   String
  file_url    String
  mime_type   String?
  file_size   Int?
  created_at  DateTime @default(now())

  @@map("support_case_attachments")
}

model SupportCaseNote {
  id         String   @id @default(uuid())
  case_id    String
  case       SupportCase @relation(fields: [case_id], references: [id], onDelete: Cascade)
  admin_id   String
  admin      User     @relation(fields: [admin_id], references: [id])
  note       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("support_case_notes")
}

model SupportCaseEvent {
  id         String   @id @default(uuid())
  case_id    String
  case       SupportCase @relation(fields: [case_id], references: [id], onDelete: Cascade)
  actor_id   String?
  event_type String
  old_value  String?
  new_value  String?
  metadata   Json?
  created_at DateTime @default(now())

  @@index([case_id])
  @@map("support_case_events")
}
